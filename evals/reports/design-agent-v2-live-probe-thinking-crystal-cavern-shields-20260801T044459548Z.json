    "gameplayDesign": {
      "coreLoop": {
        "id": "core-loop",
        "summary": "玩家在单一二维房间内自由移动，用鼠标瞄准并射击普通敌人；敌人周期性混合使用环形弹幕与定点弹幕交叉压制，场上定期刷新短时护盾拾取物；无 Boss，存活满 120 秒进入胜利结算。",
        "actionIds": [
          "player-move",
          "player-aim",
          "player-shoot"
        ]
      },
      "progression": {
        "id": "progression-120s-survival",
        "model": "timed-survival",
        "summary": "进度只由 120 秒生存倒计时驱动：期间持续刷出普通敌人与护盾拾取物，无 Boss、无关卡切换；每轮以 120 秒存活或玩家生命归零为终点。"
      },
      "pacing": {
        "id": "pacing-difficulty-ramp",
        "model": "ramping",
        "summary": "前 60 秒以低频双型敌人生成建立节奏；60 秒后追加高频增援层持续加压，环形与定点弹幕并存；护盾拾取物全程每 9 秒刷新一次，维持生存窗口内的容错。"
      }
    },
