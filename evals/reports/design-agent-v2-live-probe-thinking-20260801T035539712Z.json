    "gameplayDesign": {
      "coreLoop": {
        "id": "core-loop-survive",
        "summary": "玩家在横向 2D 弹幕场中自由移动并用鼠标瞄准射击：击毁敌机获得得分反馈，同时躲避敌机释放的混合弹幕，存活满 120 秒即进入胜利结算；若生命值耗尽则进入失败结算。",
        "actionIds": [
          "action-move-player",
          "action-player-shoot"
        ]
      },
      "progression": {
        "id": "progression-time-ramp",
        "model": "time-based-difficulty-ramp",
        "summary": "唯一目标是存活 120 秒。40 秒与 80 秒两个时间点提升敌机弹幕强度（aimed+radial 混合弹幕更密集），玩家可感知压力递增，但胜负只由生存决定，无 Boss 阶段。"
      },
      "pacing": {
        "id": "pacing-wave-pressure",
        "model": "escalating-wave",
        "summary": "敌机以固定间隔从屏幕顶部刷出并持续释放弹幕，全程压力随两个相位节点单调递增，不存在 Boss 战或大间隙休息段，保证 120 秒内的连续紧张节奏。"
      }
    },
