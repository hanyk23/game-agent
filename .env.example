# Model provider used by OpenCode. Leave values empty in version control.
OPENCODE_MODEL=

# Set to 1 only after approving the provider/model cost for the live structured-output probe.
OPENCODE_RUN_MODEL_PROBE=0

# DeepSeek provider credential. Keep the real value only in an ignored local file
# or process environment; never paste it into this example file.
DEEPSEEK_API_KEY=

# Provider-specific credentials are configured outside this repository.
# Do not put real API keys in this file.

# Optional existing OpenCode server URL. If unset, the orchestrator may start a local server.
OPENCODE_SERVER_URL=

# Optional local output root for generated game runs.
GENERATED_RUNS_DIR=
